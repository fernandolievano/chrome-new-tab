{
  "manifest_version": 3,
  "version": "2.0.0",
  "name": "New Tab - Extension",
  "short_name": "New Tab",
  "author": "Fernando Liévano",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Nueva Pestaña"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}